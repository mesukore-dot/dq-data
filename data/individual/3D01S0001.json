  "mamechishiki_pages": [
    {
      "first_appearance": "(昭和61年) 1986年5月27日、ファミコン版「ドラゴンクエスト (DQ1)」から登場。",
      "works_count": "40作品 (リメイク・アニメ・漫画等は含めない数字)",
      "what_kind": "突然変異で生まれた　メタリックなスライム。たおすと　大量の経験値が手に入るため　強欲な冒険者に　つけねらわれている。",
      "form": "光りかがやくメタルボディが特徴。でも見た目は　他のスライムと同じく　ぷにぷにしている。",
      "ability": "じまんのメタルボディは　ほぼすべての呪文を受けつけない。メラがとくいで　経験値に目がくらんだ冒険者に　火の玉をぶつける。にげあし　すばしっこさも　じまんだ！",
      "personality": "すこしの物音でもビックリしてしまう　ビンカンで　おくびょうな性格。ただし　にげる前に何発もメラを当てる　ゆうかんなメタルスライムがいるらしい。",
      "rumor": "メタルスライムにあこがれたスライムが　アルミホイルを巻いて　メタルスライムのフリをするらしい。",
      "connection": "さらに突然変異が起こると　はぐれメタルになる。",
      "links": {
        "variants_url": "#色違い"
      }
    }
  ],

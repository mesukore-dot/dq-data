  "mamechishiki_pages": [
    {
      "first_appearance": "（令和3年）2021年5月15日、兵庫県淡路島公園アニメパーク　ニジゲンノモリ「ドラゴンクエストアイランド」から登場。",
      "works_count": "4作品\n (リメイク・アニメ・漫画等は含めない数字)",
      "what_kind": "あまりにもおいしい　たまねぎをたべすぎてしまったスライム。たまねぎが有名なふるさとで　生まれたらしい。",
      "form": "温暖な気候で　太陽の光をたっぷりと浴びた素肌が特徴。皮付きと　つるんと光る皮なしの2種類がいる。",
      "connection": "同じたまねぎのまもの　オニオーン。このふたりが出会ったら　お互いに　どんな反応をするんだろう…。",
      "trivia_notes": "ドラゴンクエストの生みの親　堀井雄二さんの故郷である兵庫県淡路島。淡路島といえば　たまねぎが有名で　甘みはイチゴと同じ糖度だという。やわらかく　辛みが少ないため　たまねぎがニガテな人でも　バクバクたべられる。他にも　淡路島には　たまねぎをモチーフにしたテーマパークや　観光スポットがたくさん存在する。",
      "links": {
        "variants_url": "#色違い"
      }
    }
  ],

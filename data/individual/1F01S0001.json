  "mamechishiki_pages": [
    {
      "first_appearance": "(昭和61年) 1986年5月27日\nファミコン版「ドラゴンクエスト」から登場。",
      "works_count": "40作品 (リメイク・アニメ・マンガ等は含めない数字)",
      "what_kind": "ドラゴンクエストを代表する　おなじみの大人気モンスター！\n日本人なら　そのすがたを知らない人は　いないだろう。\nナンバリングから派生まで　すべての作品に必ず登場する。\nシリーズの顔であり　絶対的なアイドルモンスターである。",
      "form": "あおくて　まるっこい　ちょんとツノがついたフォルム。\nさわると　ひんやりなゼリー状で　ぷにぷにしている。",
      "ability": "よわくても　みんなと協力して合体！キングスライムに！\n1匹のときは　スラ・ストライクで　たいあたり攻撃！\nぜんしんを光らせ　目くらましの　スラ・フラッシュ！\nさらに極めたスライムは　口から　しゃくねつのほのおを\n吐くんだとか。ニンゲンと会話できる　スライムもいる。",
      "habitat": "世界中どこにでもいる。ただし暑い場所はニガテらしい。",
      "connection": "かよわいスライムたちを守るのは　みんなのあこがれ\nスライムナイト。すばやい剣さばきで　返り討ちにする。",
      "variants_size": "スーラ／原始のスライム／デカスライム",
      "original_concept": "堀井雄二",
      "character_design": "鳥山 明",
      "developer_story": "スライムといえば…ドロドロしたふしぎなおもちゃや\nファンタジー作品であれば 衣服をとかし ぶんれつする\n奇妙でイヤな存在でした。しかし　鳥山先生の愛らしいデザインによって　イメージをくつがえしました。",
      "links": {
        "variants_url": "#色違い",
        "job_url": "https://dqfan527.xsrv.jp/2025/09/15/slime-job/"
      }
    }
  ],
